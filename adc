#include "stm32f4xx.h"

void ADC1_Init(void);
uint16_t ADC1_Read(void);

void USART2_Init(void);
void USART2_SendChar(char c);
void USART2_SendString(char *str);


void USART2_SendNumber(uint16_t num);

void delay(volatile uint32_t t);


int main(void)
{
    uint16_t adc_value;

    USART2_Init();
    ADC1_Init();

    while (1)
    {
        /* Read ADC value */
        adc_value = ADC1_Read();

        /* Send ADC value to PC */
        USART2_SendString("ADC Value: ");
        USART2_SendNumber(adc_value);
        USART2_SendString("\r\n");

        /* Delay */
        delay(1000000);
    }
}


/*========================================================
                    ADC1 INITIALIZATION
          PA1 = ADC1 Channel 1
========================================================*/

void ADC1_Init(void)
{
    /* 1. Enable GPIOA clock */
    RCC->AHB1ENR |= (1 << 0);

    /* 2. Configure PA1 as Analog mode
          MODER1[1:0] = 11 */
    GPIOA->MODER &= ~(3 << 2);
    GPIOA->MODER |=  (3 << 2);

    /* No pull-up / pull-down */
    GPIOA->PUPDR &= ~(3 << 2);

    /* 3. Enable ADC1 clock */
    RCC->APB2ENR |= (1 << 8);

    /* 4. Sampling time
          Channel 1 is in SMPR2
          480 cycles */
    ADC1->SMPR2 &= ~(7 << 3);
    ADC1->SMPR2 |=  (7 << 3);

    /* 5. ADC common control
          PCLK2 / 2
          Independent mode */
    ADC->CCR = 0;

    /* 6. ADC CR1
          12-bit resolution
          No interrupt */
    ADC1->CR1 = 0;

    /* 7. ADC CR2
          Right aligned
          Software trigger
          Single conversion */
    ADC1->CR2 = 0;

    /* 8. Conversion sequence
          One conversion
          Channel 1 first */
    ADC1->SQR1 = 0;
    ADC1->SQR3 = 1;

    /* 9. Enable ADC1 */
    ADC1->CR2 |= (1 << 0);
}


/*========================================================
                      ADC1 READ
========================================================*/

uint16_t ADC1_Read(void)
{
    uint16_t result;

    /* Start conversion */
    ADC1->CR2 |= (1 << 30);

    /* Wait for End Of Conversion */
    while ((ADC1->SR & (1 << 1)) == 0)
    {
    }

    /* Read ADC result */
    result = ADC1->DR;

    return result;
}


/*========================================================
                    USART2 INITIALIZATION
                  9600 BAUD RATE

              PA2 = USART2_TX
              PA3 = USART2_RX
========================================================*/

void USART2_Init(void)
{
    /* Enable GPIOA clock */
    RCC->AHB1ENR |= (1 << 0);

    /* Enable USART2 clock */
    RCC->APB1ENR |= (1 << 17);

    /* PA2 = Alternate Function mode */
    GPIOA->MODER &= ~(3 << 4);
    GPIOA->MODER |=  (2 << 4);

    /* PA3 = Alternate Function mode */
    GPIOA->MODER &= ~(3 << 6);
    GPIOA->MODER |=  (2 << 6);

    /* Select AF7 for PA2 */
    GPIOA->AFR[0] &= ~(0xF << 8);
    GPIOA->AFR[0] |=  (7 << 8);

    /* Select AF7 for PA3 */
    GPIOA->AFR[0] &= ~(0xF << 12);
    GPIOA->AFR[0] |=  (7 << 12);

    /*
       USART2 clock assumed = 16 MHz
       Baud rate = 9600
       BRR = 0x0683
    */
    USART2->BRR = 0x0683;

    /* Enable USART2 and transmitter */
    USART2->CR1 = (1 << 13) | (1 << 3);
}


/*========================================================
                    SEND CHARACTER
========================================================*/

void USART2_SendChar(char c)
{
    /* Wait until TXE = 1 */
    while ((USART2->SR & (1 << 7)) == 0)
    {
    }

    USART2->DR = c;
}


/*========================================================
                    SEND STRING
========================================================*/

void USART2_SendString(char *str)
{
    while (*str)
    {
        USART2_SendChar(*str);
        str++;
    }
}


/*========================================================
                    SEND NUMBER
========================================================*/

void USART2_SendNumber(uint16_t num)
{
    char buffer[10];
    int i = 0;

    if (num == 0)
    {
        USART2_SendChar('0');
        return;
    }

    while (num > 0)
    {
        buffer[i] = (num % 10) + '0';
        num = num / 10;
        i++;
    }

    while (i > 0)
    {
        i--;
        USART2_SendChar(buffer[i]);
    }
}


/*========================================================
                        DELAY
========================================================*/

void delay(volatile uint32_t t)
{
    while (t--)
    {
    }
}
