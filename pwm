#include "stm32f4xx.h"

int main(void)
{
    // Enable GPIOA clock
    RCC->AHB1ENR |= 1;

    // Enable TIM2 clock
    RCC->APB1ENR |= 1;

    // PA5 -> Alternate Function mode
    GPIOA->MODER &= ~0x00000C00;
    GPIOA->MODER |=  0x00000800;

    // PA5 -> AF1 -> TIM2_CH1
    GPIOA->AFR[0] &= ~0x00F00000;
    GPIOA->AFR[0] |=  0x00100000;

    // TIM2 configuration

    // Prescaler = 9
    TIM2->PSC = 9;

    // PWM period
    TIM2->ARR = 26666;

    // PWM duty cycle
    TIM2->CCR1 = 8889;

    // PWM Mode 1c
    TIM2->CCMR1 = 0x60;

    // Enable PWM Channel 1
    TIM2->CCER = 1;

    // Enable Timer
    TIM2->CR1 = 1;
    GPIOA->MODER &= ~(3);
    GPIOA->MODER |=  0x00000001;
    while (1)
    {
    GPIOA->ODR=1;

    }
}
